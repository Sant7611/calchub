9:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":["A salary moves from ",["$","strong",null,{"children":"Rs. 60,000"}]," to ",["$","strong",null,{"children":"Rs. 66,000"}],":"]}]
a:["$","ol",null,{"className":"mt-4 list-decimal space-y-2 pl-6 text-slate-700","children":["\n",["$","li",null,{"children":["Difference: 66,000 − 60,000 = ",["$","strong",null,{"children":"6,000"}]]}],"\n",["$","li",null,{"children":["6,000 ÷ 60,000 = ",["$","strong",null,{"children":"0.10"}]]}],"\n",["$","li",null,{"children":["× 100 = ",["$","strong",null,{"children":"10%"}]]}],"\n"]}]
b:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":"A \"6k raise\" sounds vague; a 10% raise is instantly comparable to inflation\nor another offer."}]
c:["$","h2",null,{"className":"mt-10 text-2xl font-bold tracking-tight text-slate-900","children":"Example 3 — when the change is negative"}]
d:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":"Fuel drops from Rs. 170 to Rs. 153 per litre:"}]
e:["$","ol",null,{"className":"mt-4 list-decimal space-y-2 pl-6 text-slate-700","children":["\n",["$","li",null,{"children":["Difference: 153 − 170 = ",["$","strong",null,{"children":"−17"}]]}],"\n",["$","li",null,{"children":["−17 ÷ 170 = ",["$","strong",null,{"children":"−0.10"}]]}],"\n",["$","li",null,{"children":["× 100 = ",["$","strong",null,{"children":"−10%"}]]}],"\n"]}]
f:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":["A negative result is simply a ",["$","strong",null,{"children":"percentage decrease"}],". The same formula covers\nboth directions — you don't need a second one."]}]
10:["$","div",null,{"className":"my-8 rounded-xl border border-amber-200 bg-amber-50 p-5","children":[["$","p",null,{"className":"flex items-center gap-2 text-sm font-bold text-amber-800","children":[["$","$L3",null,{"iconNode":[["path",{"d":"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5","key":"1gvzjb"}],["path",{"d":"M9 18h6","key":"x1upvd"}],["path",{"d":"M10 22h4","key":"ceow96"}]],"className":"lucide-lightbulb h-4 w-4"}],"The mistake almost everyone makes"]}],["$","div",null,{"className":"mt-2 text-sm leading-relaxed text-amber-900/90","children":["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":["Always divide by the ",["$","strong",null,{"children":"old"}]," value — the starting point — never the new one.\nIn the rent example, dividing 3,000 by 28,000 gives 10.7%, which understates\nthe hike. The base of comparison is where the change ",["$","em",null,{"children":"started"}],"."]}]}]]}]
11:["$","h2",null,{"className":"mt-10 text-2xl font-bold tracking-tight text-slate-900","children":"The reverse calculation"}]
12:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":"News stories often give you the percentage and hide the numbers: \"prices rose\n8%\". To recover the new price from an old price:"}]
13:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":["$","code",null,{"className":"rounded bg-slate-100 px-1.5 py-0.5 font-mono text-sm text-slate-800","children":"new value = old value × (1 + percentage ÷ 100)"}]}]
14:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":["So a Rs. 500 grocery basket after an 8% rise costs 500 × 1.08 = ",["$","strong",null,{"children":"Rs. 540"}],"."]}]
15:["$","h2",null,{"className":"mt-10 text-2xl font-bold tracking-tight text-slate-900","children":"Compound increases are not additive"}]
16:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":"Two 10% raises in a row are not 20%. After the first, your base has grown:"}]
17:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":["$","code",null,{"className":"rounded bg-slate-100 px-1.5 py-0.5 font-mono text-sm text-slate-800","children":"100 → +10% → 110 → +10% → 121"}]}]
18:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":"That's 21% overall. This is the same compounding logic behind inflation over\nmultiple years and the reason multi-year figures should always be checked\nyear by year — or with a calculator."}]
