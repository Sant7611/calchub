1a:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":["The ",["$","a",null,{"className":"font-medium text-indigo-600 underline decoration-indigo-300 underline-offset-4 transition-colors hover:text-indigo-800","href":"/tools/math/percentage-calculator","children":"Percentage Calculator"}]," runs the\nformula instantly: enter the old and new values and it returns the signed\npercentage — positive for an increase, negative for a decrease — along with\nthe raw difference. It is handy for checking pay slips, comparing quotes and\nfact-checking the \"up to 50% off\" signs that quietly started from an inflated\nprice."]}]
1b:["$","h2",null,{"className":"mt-10 text-2xl font-bold tracking-tight text-slate-900","children":"The takeaway"}]
1c:["$","p",null,{"className":"mt-4 leading-relaxed text-slate-700","children":"One formula covers every rise and fall: difference ÷ old value × 100.\nDivide by the starting number, keep the sign, and remember that repeated\npercentages compound rather than add. Master that and every \"X% increase\"\nheadline becomes a ten-second check."}]
