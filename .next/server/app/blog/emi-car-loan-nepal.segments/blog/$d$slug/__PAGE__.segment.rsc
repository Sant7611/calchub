:["EMI stands for ","$L4"," — the fixed amount you pay the\nbank every month until the loan is fully repaid. Every installment contains\ntwo parts:"]}],"\n","$L5","\n","$L6","\n","$L7","\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a"]}],"$L1b"]}],null,"$L1c"]}],"isPartial":"$@1d","staleTime":"$1e","varyParams":null},{"rsc":"$L1f","isPartial":"$@20","staleTime":"$1e","varyParams":null},{"rsc":"$L21","isPartial":"$@22","staleTime":"$1e","varyParams":"$23"},{"rsc":"$L24","isPartial":"$@25","staleTime":"$1e","varyParams":"$23"},{"rsc":"$L26","isPartial":"$@27","staleTime":"$1e","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@28","rootVaryParams":null,"needsRuntimeRequest":"$@29"}
