7:["$","section",null,{"className":"mt-12","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900","children":"Formula & Explanation"}],["$","div",null,{"className":"mt-4 rounded-xl border border-slate-200 bg-slate-50 p-5","children":[["$","h3",null,{"className":"font-semibold text-slate-900","children":"EMI Formula (Reducing Balance Method)"}],["$","p",null,{"className":"mt-2 leading-relaxed text-slate-600","children":"EMI = P × r × (1+r)ⁿ / [(1+r)ⁿ − 1], where P = loan principal, r = monthly interest rate (annual rate ÷ 12 ÷ 100), and n = loan tenure in months. This formula ensures each payment is identical throughout the loan term, with the interest portion decreasing and principal portion increasing over time."}]]}]]}]
17:T59e,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is EMI and how is it calculated?","acceptedAnswer":{"@type":"Answer","text":"EMI stands for Equated Monthly Installment. It's a fixed amount paid monthly towards repaying a loan. Banks calculate EMI using the reducing balance method, where interest is computed on the outstanding principal each month."}},{"@type":"Question","name":"Does EMI change over the loan tenure?","acceptedAnswer":{"@type":"Answer","text":"For fixed-rate loans, the EMI remains constant throughout. However, if you have a floating/variable rate loan, the EMI may change when the interest rate resets. Some lenders adjust the tenure instead of the EMI when rates change."}},{"@type":"Question","name":"How can I reduce my EMI burden?","acceptedAnswer":{"@type":"Answer","text":"You can lower your EMI by: (1) opting for a longer tenure, (2) making a larger down payment to reduce the principal, (3) improving your credit score to qualify for lower interest rates, or (4) making partial prepayments when possible."}},{"@type":"Question","name":"Is this EMI calculator accurate for Nepal and India?","acceptedAnswer":{"@type":"Answer","text":"Yes. This calculator uses the same reducing-balance formula used by banks in Nepal and India. It supports NPR (Rs.), INR (₹), and USD ($) with region-specific default amounts and interest rates for realistic estimates."}}]}8:["$","section",null,{"className":"mt-12","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],["$","h2",null,{"className":"text-2xl font-bold text-slate-900","children":"Frequently Asked Questions"}],["$","div",null,{"className":"mt-5 divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white","children":[["$","details","What is EMI and how is it calculated?",{"className":"group px-5 py-4","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items