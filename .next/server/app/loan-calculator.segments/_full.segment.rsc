1a:["$","section",null,{"className":"mt-12","children":[["$","h2",null,{"className":"text-2xl font-bold text-slate-900","children":"Formula & Explanation"}],["$","div",null,{"className":"mt-4 rounded-xl border border-slate-200 bg-slate-50 p-5","children":[["$","h3",null,{"className":"font-semibold text-slate-900","children":"The amortization (equal-installment) formula"}],["$","p",null,{"className":"mt-2 leading-relaxed text-slate-600","children":"Monthly payment M = P × [ r(1+r)ⁿ ] / [ (1+r)ⁿ − 1 ], where P is the principal, r is the monthly interest rate (annual rate ÷ 12) and n is the total number of monthly payments (years × 12). Each payment covers that month's interest first; the remainder reduces the principal, which is why early payments are interest-heavy and later payments chip away at the balance faster."}]]}]]}]
1d:T556,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the monthly payment the only thing I'll pay?","acceptedAnswer":{"@type":"Answer","text":"No. The monthly payment covers principal and interest only. Real loans often add origination fees, insurance or taxes (for mortgages). Use the total-interest figure here to compare the financing cost, then add any fees a lender discloses."}},{"@type":"Question","name":"Why does a longer term cost more overall?","acceptedAnswer":{"@type":"Answer","text":"Interest accrues on the outstanding balance every month. Spreading repayment over more months means the balance stays higher for longer, so more interest accumulates even though each individual payment is smaller."}},{"@type":"Question","name":"What happens if I make extra payments?","acceptedAnswer":{"@type":"Answer","text":"Extra payments reduce the principal early, which lowers the interest charged in every remaining month. You'll either pay the loan off sooner or shrink future payments, depending on your lender's recalculation policy."}},{"@type":"Question","name":"Does this work for variable-rate loans?","acceptedAnswer":{"@type":"Answer","text":"It gives an accurate snapshot at today's rate. If your rate can change, treat the result as a starting point and re-run the calculator whenever the rate resets."}}]}1b:["$","section",null,{"className":"mt-12","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1d"}}],["$","h2",null,{"className":"text-2xl font-bold text-slate-900","children":"Frequently Asked Questions"}],["$","div",null,{"className":"mt-5 divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white","children":[["$","details","Is the monthly payment the only thing I'll pay?",{"className":"group px-5 py-4","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-slate-900 tr